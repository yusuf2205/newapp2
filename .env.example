# ---------- Telegram ----------
BOT_TOKEN=123456:AA...
ADMIN_IDS=123456789
# Группа для выгрузки договоров (извлечение ИНН). Пусто = любая группа с ботом.
# ID узнать после добавления бота в группу — см. README.
INN_GROUP_CHAT_ID=

# ---------- Google Диск (автослежение за папкой с договорами) ----------
# Пусто = функция выключена. Папку нужно открыть сервисному аккаунту бота
# (client_email из credentials.json) хотя бы с правом «читатель», ID папки — из
# её ссылки: https://drive.google.com/drive/folders/<это и есть ID>
GOOGLE_DRIVE_FOLDER_ID=
DRIVE_POLL_SECONDS=300
# Куда слать уведомления об автозаписи. Пусто = в INN_GROUP_CHAT_ID.
DRIVE_NOTIFY_CHAT_ID=

# ---------- OCR ----------
# anthropic | openai | gemini | tesseract
OCR_ENGINE=anthropic

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# TESSERACT_LANG=rus+uzb+eng
# TESSERACT_CMD=/usr/bin/tesseract

# ---------- Google Sheets ----------
SPREADSHEET_ID=1AbCdEf...
GOOGLE_CREDENTIALS_FILE=credentials.json
SHEET_DATA=Данные
SHEET_EMPLOYEES=Сотрудники
SHEET_PROJECTS=Проекты

# ---------- Справочники ----------
# Проекты разделяются символом |
PROJECTS=🏢 Чукурсой завод|🏗 Ийк Ота завод|⚙️ Цех учун
DEFAULT_CURRENCY=UZS
DEFAULT_CONTRACT_TYPE=Местный
